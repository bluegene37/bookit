# Gene - Nov, 08, 2026: Sanitized Environment Variable Template for BookIt (Local, Vercel & Supabase Edge Functions)
# Copy this file to `.env` for local development. NEVER commit real secrets or `.env` to version control.

# -----------------------------------------------------------------------------
# 1. Flutter Client / Vercel Build Environment Variables (--dart-define)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-anon-key
FORCE_MOCK_MODE=false

# -----------------------------------------------------------------------------
# 2. Supabase Edge Functions Secrets (Set via `supabase secrets set`)
# -----------------------------------------------------------------------------
# Stripe Connect Express & Webhook Verification
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

# Allowed Web Origin for CORS & Redirect Validation (e.g., your Vercel production domain)
ALLOWED_ORIGIN=https://your-bookit-beta.vercel.app

# Scheduled Reminder Dispatch Authentication Secret (`dispatch-reminders` function)
CRON_SECRET=your-random-32-byte-cron-secret

# Optional Email & SMS Notification Providers (`dispatch-reminders` function)
RESEND_API_KEY=re_your_resend_api_key
SENDGRID_API_KEY=SG.your_sendgrid_api_key
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15550000000
